---====== Debug callbacks ======---

entity:SetCallback("OnSpawned", function()
    print("Insanity spawned")
end)

entity:SetCallback("OnStartMoving", function()
    print("Insanity moving")
end)

entity:SetCallback("OnRebounding", function(start)
    if start then
        print("Insanity rebounding")
    end
end)

entity:SetCallback("OnDamagePlayer", function(hp)
    if hp <= 0 then
        print("Player died to Insanity")
    end
end)

---====== Run entity ======---

entity:Run()
