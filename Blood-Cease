---====== Custom Logic Variables ======---

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")

local movementConnection = nil
local lavenderColor = Color3.fromRGB(255, 0, 0)
local tweenInfo = TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- CONFIGURABLE DETECTION FIELD
local MAX_DETECTION_DISTANCE = 75 
local VISION_ANGLE_THRESHOLD = 0.75 

-- Function to smoothly fade light colors using TweenService
local function changeLightColors()
    local currentRoom = workspace:FindFirstChild("CurrentRooms")
    if currentRoom then
        for _, room in ipairs(currentRoom:GetChildren()) do
            for _, desc in ipairs(room:GetDescendants()) do
                if desc:IsA("Light") then
                    TweenService:Create(desc, tweenInfo, {Color = lavenderColor}):Play()
                elseif desc:IsA("BasePart") and (desc.Name == "Light" or desc.Name == "Neon" or desc.Name == "Bulb") then
                    TweenService:Create(desc, tweenInfo, {Color = lavenderColor}):Play()
                end
            end
        end
    end
end

-- Integrated snippet logic: Checks direct WASD vector or closet velocity
local function isPlayerMoving()
    if Humanoid and Humanoid.MoveDirection ~= Vector3.new(0, 0, 0) then
        return true
    end
    
    local rootPart = Character:FindFirstChild("HumanoidRootPart")
    if rootPart and rootPart.AssemblyLinearVelocity.Magnitude > 0.4 then
        return true
    end
    
    return false
end

-- Completely strip collision from Cease's physical body parts
local function disableEntityCollision(model)
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("BasePart") then
            desc.CanCollide = false
            desc.CanTouch = false
            desc.CanQuery = false
        end
    end
end

---====== Callback Setup ======---

entity:SetCallback("OnSpawned", function()
    print("Entity has spawned")
    changeLightColors()
    
    task.spawn(function()
        local entityModel = workspace:WaitForChild("Cease", 5)
        if entityModel then
            disableEntityCollision(entityModel)
            
            local startTime = os.clock()
            while os.clock() - startTime < 3 do
                local repent = entityModel:FindFirstChild("Repent", true)
                if repent and repent:IsA("Sound") then
                    repent:Stop()
                    repent:Destroy()
                    break
                end
                task.wait(0.05)
            end
        end
    end)
end)

entity:SetCallback("OnStartMoving", function()
    print("Entity has started moving")
    
    local entityModel = workspace:FindFirstChild("Cease")
    if not entityModel then return end
    
    disableEntityCollision(entityModel)
    
    local lastPosition = entityModel.PrimaryPart and entityModel.PrimaryPart.Position or Vector3.new()
    
    movementConnection = RunService.Heartbeat:Connect(function()
        if not entityModel or not entityModel.Parent or not entityModel:IsDescendantOf(workspace) then
            if movementConnection then movementConnection:Disconnect() end
            return
        end
        
        local targetPart = Character:FindFirstChild("HumanoidRootPart")
        local originPart = entityModel.PrimaryPart or entityModel:FindFirstChildWhichIsA("BasePart")
        
        if originPart and targetPart and Humanoid.Health > 0 then
            local currentPosition = originPart.Position
            local toPlayerVector = (targetPart.Position - currentPosition)
            local distance = toPlayerVector.Magnitude
            
            -- Calculate head tracking heading direction based on frame displacement
            local displacement = (currentPosition - lastPosition)
            local entityMoveDirection = displacement.Magnitude > 0.01 and displacement.Unit or originPart.CFrame.LookVector
            lastPosition = currentPosition 
            
            if distance <= MAX_DETECTION_DISTANCE then
                local directionToPlayer = toPlayerVector.Unit
                local dotProduct = directionToPlayer:Dot(entityMoveDirection)
                
                if dotProduct >= VISION_ANGLE_THRESHOLD or Character:GetAttribute("Hiding") then
                    
                    -- Generating legacy Ray for compatibility
                    local legacyRay = Ray.new(currentPosition, toPlayerVector)
                    local ignoreList = {entityModel, Character}
                    local hitPart, hitPosition = workspace:FindPartOnRayWithIgnoreList(legacyRay, ignoreList)
                    
                    if not hitPart then
                        if isPlayerMoving() then
                            if movementConnection then movementConnection:Disconnect() end
                            
                            -- Update backend death cause metric dynamically
                            pcall(function()
                                local playerStats = ReplicatedStorage:FindFirstChild("GameStats")
                                if playerStats then
                                    local targetedFolder = playerStats:FindFirstChild("Player_" .. LocalPlayer.Name)
                                    if targetedFolder and targetedFolder:FindFirstChild("Total") and targetedFolder.Total:FindFirstChild("DeathCause") then
                                        targetedFolder.Total.DeathCause.Value = "Cease"
                                    end
                                end
                            end)
                            
                            Humanoid.Health = 0
                            task.defer(function()
                                Spawner:Kill()
                            end)
                        end
                    end
                end
            end
        end
    end)
end)

entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
    changeLightColors()
    local entityModel = workspace:FindFirstChild("Cease")
    if entityModel then disableEntityCollision(entityModel) end
end)

entity:SetCallback("OnDespawning", function()
