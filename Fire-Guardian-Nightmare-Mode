---====== Asset Handling ======---
local fileName = "FireGuardianArrivalSpawn.mp3"
local soundUrl = "https://github.com/idkman60093/Audio/raw/refs/heads/main/FireGuardian%2520Arrival%2520Sound.mp3"

-- Ensure the sound is downloaded locally
if not isfile(fileName) then
    print("Downloading sound for the first time...")
    writefile(fileName, game:HttpGet(soundUrl))
end

local function playSpawnSound()
    local success, assetId = pcall(function()
        return getcustomasset(fileName)
    end)

    if success then
        local sound = Instance.new("Sound")
        sound.SoundId = assetId
        sound.Volume = 3
        sound.Parent = game:GetService("SoundService")
        sound:Play()
        
        sound.Ended:Connect(function()
            sound:Destroy()
        end)
    else
        warn("Failed to play local asset: " .. fileName)
    end
end

local function onEntityGone()
	print("Fire Guardian destroyed/despawned")

	if not getgenv().FGAchievementExecuted then
    getgenv().FGAchievementExecuted = true

    loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"))()({
        Title = "Im Back",
        Desc = "Why you hiding?",
        Reason = "Encounter Fire Guardian",
        Image = "rbxassetid://128422180137442",
    })
end
end

